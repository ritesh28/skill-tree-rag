    "skill-frontmatter-check": "tsx src/skills/cli.ts frontmatter-check"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pdfkit": "^0.17.6",
    "@vitest/coverage-v8": "^5.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "pdfkit": "^0.20.2",
    "zod": "^4.5.4"
  }
}
