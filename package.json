{
  "name": "skill-tree-rag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "skill-sync": "tsx src/skills/cli.ts sync",
    "skill-structure-check": "tsx src/skills/cli.ts structure-check",
